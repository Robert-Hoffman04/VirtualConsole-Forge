{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VirtualConsole-Forge",
  "version": "0.1.0",
  "identifier": "dev.forge.virtualconsole",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "VirtualConsole-Forge",
        "width": 960,
        "height": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
